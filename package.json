{
  "name": "qaq-revival",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "description": "QAQ-Revival — locally maintained Mod manager",
  "scripts": {
    "build": "node tools/build.cjs",
    "build:components": "node tools/build-components.cjs",
    "update:components": "node tools/update-components.cjs",
    "test": "node tools/build-mega.cjs --test && node tools/build-steam-bridge.cjs --test && node tools/build-tray-host.cjs && node tools/build-key-helper.cjs --test && node --test tests/*.test.cjs && node tools/smoke.cjs && node tools/smoke.cjs --single-instance && node tools/smoke.cjs --translation && node tools/smoke.cjs --hidden-characters && node tools/smoke.cjs --steam-bridge && node tools/smoke.cjs --arknights",
    "test:single-instance": "node --test tests/single-instance.test.cjs && node tools/smoke.cjs --single-instance",
    "test:genshin": "node --test tests/genshin.test.cjs tests/windows-launch.test.cjs && node tools/smoke.cjs --genshin",
    "test:random-launch": "node --test tests/random-executable.test.cjs tests/single-instance.test.cjs tests/windows-launch.test.cjs && node tests/random-runtime-smoke.cjs",
    "test:game-settings": "node --test tests/wuwa-tuning.test.cjs tests/wuwa-dx12.test.cjs tests/random-executable.test.cjs && node tools/smoke.cjs --game-settings",
    "test:electron": "node tools/smoke.cjs",
    "test:translation": "node --test tests/hotkey-translation.test.cjs && node tools/smoke.cjs --translation",
    "test:hidden-characters": "node --test tests/hidden-characters.test.cjs && node tools/smoke.cjs --hidden-characters",
    "test:character-images": "node --test tests/character-image-cache.test.cjs && node tools/smoke.cjs --character-images",
    "test:character-skins": "node --test tests/character-skin-catalog.test.cjs && node tools/smoke.cjs --character-skins",
    "build:mega": "node tools/build-mega.cjs",
    "build:key-helper": "node tools/build-key-helper.cjs",
    "test:key-helper": "node tools/build-key-helper.cjs --test",
    "test:genshin-check": "node --test tests/genshin-diagnostics.test.cjs && node tools/smoke.cjs --genshin-check",
    "test:genshin-anticrash": "node --test tests/genshin-anticrash.test.cjs && node tools/smoke.cjs --genshin-anticrash",
    "test:persist": "node --test tests/persist-settings.test.cjs && node tools/smoke.cjs --persist",
    "test:overlay-activity": "node --test tests/overlay-activity.test.cjs && node tools/smoke.cjs --overlay-activity",
    "test:steam-bridge": "node tools/build-steam-bridge.cjs --test && node --test tests/steam-bridge.test.cjs && node tools/smoke.cjs --steam-bridge",
    "build:app": "node tools/build-app.cjs",
    "dev:renderer": "vite --config vite.config.mjs",
    "check:i18n": "node tools/check-i18n.cjs",
    "lint": "eslint app/src",
    "test:unit": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run check:i18n",
    "format": "prettier --write app/src"
  },
  "productName": "QAQ-Revival",
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@babel/traverse": "8.0.7",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
